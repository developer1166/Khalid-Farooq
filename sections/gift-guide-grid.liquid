{{ 'gift-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide.js' | asset_url }}" defer></script>

<section
  id="GiftGuideGrid-{{ section.id }}"
  class="gift-guide-grid"
  data-gift-guide-grid
  data-section-id="{{ section.id }}"
>
  {% if section.settings.bonus_product != blank %}
    <script
      type="application/json"
      data-gift-bonus-product
    >
      {
        "id": {{ section.settings.bonus_product.id | json }},
        "title": {{ section.settings.bonus_product.title | json }},
        "variants": [
          {% for variant in section.settings.bonus_product.variants %}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "options": {{ variant.options | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}

  <div class="gift-guide-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="gift-guide-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="gift-guide-grid__items">

      {% for block in section.blocks %}
        {% assign gift_product = block.settings.product %}

        <article
          class="gift-guide-grid__item"
          data-gift-card
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >

          {% if gift_product != blank %}

            {% if gift_product.featured_image %}
              {{
                gift_product.featured_image
                | image_url: width: 900
                | image_tag:
                  class: 'gift-guide-grid__image',
                  loading: 'lazy',
                  widths: '300, 433, 600, 900',
                  sizes: '(min-width: 1101px) 433px, 50vw',
                  alt: gift_product.featured_image.alt
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'gift-guide-grid__placeholder' }}
            {% endif %}

            <script
              type="application/json"
              id="GiftProduct-{{ section.id }}-{{ block.id }}"
            >
              {
                "id": {{ gift_product.id | json }},
                "title": {{ gift_product.title | json }},
                "description": {{ gift_product.description | strip_html | json }},
                "featured_image": {{ gift_product.featured_image | image_url: width: 600 | json }},

                "options": [
                  {% for option in gift_product.options_with_values %}
                    {
                      "name": {{ option.name | json }},
                      "values": {{ option.values | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ],

                "variants": [
                  {% for variant in gift_product.variants %}
                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "price": {{ variant.price | json }},
                      "available": {{ variant.available | json }},
                      "options": {{ variant.options | json }},
                      "option1": {{ variant.option1 | json }},
                      "option2": {{ variant.option2 | json }},
                      "option3": {{ variant.option3 | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            </script>

            <button
              type="button"
              class="gift-guide-grid__hotspot"
              data-gift-open
              data-product-id="GiftProduct-{{ section.id }}-{{ block.id }}"
              aria-label="View {{ gift_product.title | escape }}"
            >
              <span aria-hidden="true">+</span>
            </button>

          {% else %}

            {{ 'product-1' | placeholder_svg_tag: 'gift-guide-grid__placeholder' }}

            <button
              type="button"
              class="gift-guide-grid__hotspot"
              disabled
              aria-label="Select a product in the theme editor"
            >
              <span aria-hidden="true">+</span>
            </button>

          {% endif %}

        </article>
      {% endfor %}

    </div>
  </div>


  <!-- PRODUCT POPUP -->

  <div
    class="gift-guide-modal"
    data-gift-modal
    aria-hidden="true"
  >

    <button
      type="button"
      class="gift-guide-modal__backdrop"
      data-gift-close
      aria-label="Close product popup"
      tabindex="-1"
    ></button>

    <div
      class="gift-guide-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Product details"
      tabindex="-1"
    >

      <button
        type="button"
        class="gift-guide-modal__close"
        data-gift-close
        aria-label="Close popup"
      >
        <span aria-hidden="true">&times;</span>
      </button>


      <div class="gift-guide-modal__product">

        <div class="gift-guide-modal__image-wrap">
          <img
            class="gift-guide-modal__image"
            data-gift-product-image
            src=""
            alt=""
            width="120"
            height="140"
          >
        </div>

        <div class="gift-guide-modal__details">

          <h3
            class="gift-guide-modal__title"
            data-gift-product-title
          ></h3>

          <p
            class="gift-guide-modal__price"
            data-gift-product-price
          ></p>

          <div
            class="gift-guide-modal__description"
            data-gift-product-description
          ></div>

        </div>
      </div>


      <!-- OPTIONS -->

      <div class="gift-guide-modal__options">

        <!-- COLOR -->

        <div
          class="gift-guide-modal__option"
          data-gift-color-group
          hidden
        >
          <div class="gift-guide-modal__label">
            Color
          </div>

          <div
            class="gift-guide-modal__colors"
            data-gift-colors
            role="group"
            aria-label="Choose a color"
          ></div>
        </div>


        <!-- CUSTOM SIZE -->

        <div
          class="gift-guide-modal__option"
          data-gift-size-group
          hidden
        >
          <div class="gift-guide-modal__label">
            Size
          </div>

          <div
            class="gift-guide-modal__size"
            data-gift-size-dropdown
          >

            <button
              type="button"
              class="gift-guide-modal__size-trigger"
              data-gift-size-trigger
              aria-expanded="false"
            >
              <span data-gift-size-text>
                Choose your size
              </span>

              <span
                class="gift-guide-modal__size-arrow"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 12 7"
                  width="12"
                  height="7"
                >
                  <path
                    d="M1 1l5 5 5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
              </span>
            </button>

            <div
              class="gift-guide-modal__size-menu"
              data-gift-size-menu
              hidden
            ></div>

          </div>
        </div>

      </div>


      <p
        class="gift-guide-modal__message"
        data-gift-message
        role="status"
        aria-live="polite"
      ></p>


      <button
        type="button"
        class="gift-guide-modal__add"
        data-gift-add
        disabled
      >
        <span data-gift-add-label>
          ADD TO CART
        </span>

        <span
          class="gift-guide-modal__add-arrow"
          aria-hidden="true"
        >
          ⟶
        </span>
      </button>

    </div>
  </div>
</section>


{% schema %}
{
  "name": "Gift Guide Grid",
  "tag": "section",
  "class": "gift-guide-grid-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Grid heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus product for Black + Medium",
      "info": "Select Soft Winter Jacket. It will be added when the selected variant has both Black and Medium options."
    }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Gift product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],

  "max_blocks": 6,

  "presets": [
    {
      "name": "Gift Guide Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}